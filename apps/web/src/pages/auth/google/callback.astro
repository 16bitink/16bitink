---
import Base from '../../../layouts/Base.astro';
import { signInPageUrl } from '../../../lib/buyFlow';
import { NO_LEAK } from '../../../lib/appSignIn';
import { googleCallback } from '../../../lib/googleCallback';

export const prerender = false;

for (const [k, v] of Object.entries(NO_LEAK)) Astro.response.headers.set(k, v);

// All the work is in lib/googleCallback.ts; this page only shows what went wrong.
const result = await googleCallback(Astro.cookies, Astro.url, Math.floor(Date.now() / 1000));
if (result instanceof Response) return result;
const { error, ret } = result;
---
<Base title="Sign in" description="Sign in with Google">
  <meta name="referrer" content="no-referrer" slot="head" />
  <section class="paper-card narrow">
    <h1>Not signed in</h1>
    <p>{error}</p>
    <a class="btn" href={signInPageUrl(ret)}>Try again</a>
  </section>
</Base>
